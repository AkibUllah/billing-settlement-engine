DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra public origins allowed to post forms (admin) when served behind a proxy, e.g. Codespaces.
# Render's hostname is added automatically from RENDER_EXTERNAL_HOSTNAME.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# SQLite by default; Postgres in docker-compose
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://billing:billing@db:5432/billing

# Bangladesh VAT applied on service fees (percent)
DEFAULT_VAT_RATE=15
